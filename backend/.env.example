# Server Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cafe_management?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/cafe_management?retryWrites=true&w=majority

# Render External URL for keep-alive cron job
# Example: https://cafe-management-api.onrender.com
RENDER_EXTERNAL_URL=

# Allowed Client Origin(s) for CORS (comma-separated or single URL)
CLIENT_URL=http://localhost:5173
