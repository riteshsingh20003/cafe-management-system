# ==============================================================================
# Cafe Menu & Order Management System - Environment Variables Template
# ==============================================================================
# Copy this file to `.env` in the root (for Docker Compose) or inside
# `backend/.env` and `frontend/.env` respectively.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server Configuration (backend/.env)
# ------------------------------------------------------------------------------
# Port for the Node.js / Express backend server
PORT=5000

# Application environment: development | production | test
NODE_ENV=development

# MongoDB Connection String:
# - Local MongoDB instance:
#   MONGODB_URI=mongodb://localhost:27017/cafe_db
# - Docker Compose internal network:
#   MONGODB_URI=mongodb://mongo:27017/cafe_db
# - MongoDB Atlas Cloud Cluster:
#   MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cafe_management?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/cafe_db

# Allowed CORS client origin(s) (single origin or comma-separated)
CLIENT_URL=http://localhost:5173,http://localhost:3000

# Optional: Public Render deployment URL for automatic keep-alive self-pings
# Prevents free-tier Render instances from spinning down after 15 min inactivity
RENDER_EXTERNAL_URL=https://cafe-management-api.onrender.com

# ------------------------------------------------------------------------------
# 2. Frontend Client Configuration (frontend/.env)
# ------------------------------------------------------------------------------
# Base API endpoint for the React application
# - Local dev without Docker:
#   VITE_API_URL=http://localhost:5000/api
# - In Production (Vercel pointing to Render):
#   VITE_API_URL=https://cafe-management-api.onrender.com/api
# - In Docker Compose (browser access):
#   VITE_API_URL=http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# 3. Docker Compose Orchestration Overrides (Optional)
# ------------------------------------------------------------------------------
MONGO_PORT=27017
BACKEND_PORT=5000
FRONTEND_PORT=3000
MONGO_INITDB_DATABASE=cafe_db
